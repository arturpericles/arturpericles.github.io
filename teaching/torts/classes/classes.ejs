<% for (const item of items) { %>
::: {.quarto-post .image-right}
::: {.body}
<% if (item.title) { %>
<h2 class="no-anchor listing-title class-listing-title"><a href="<%- item.path %>" class="no-external"><%= item.title %></a></h2>
<% } %>
<% if (item.description) { %>
<div class="delink listing-description"><a href="<%- item.path %>" class="no-external"><%= item.description %></a></div>
<% } %>
:::
<% if (item.date) { %>
::: {.metadata}
<a href="<%- item.path %>" class="no-external"><div class="metadata-value listing-date"><%= item.date %></div></a>
:::
<% } %>
:::
<% } %>
